    "date": "2024-06-19"
  },
  "executed_sql": "SELECT e.event_name\nFROM event e\nJOIN expense ex ON e.event_id = ex.link_to_budget\nJOIN budget b ON ex.link_to_budget = b.link_to_event\nGROUP BY e.event_name\nORDER BY MIN(ex.cost) LIMIT 1;",

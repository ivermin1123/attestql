    given-names: "Hoang"
repository-code: "https://github.com/ivermin1123/attestql"
url: "https://attestql.com"
license: Apache-2.0
version: "0.3.1"
date-released: "2026-09-12"
keywords:
  - text-to-sql
  - benchmark
  - evaluation
  - sql
  - postgresql
  - sqlite
  - audit
